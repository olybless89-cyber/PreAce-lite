<%#
  views/dashboard/withdrawal.eta

  This is the page BODY only. Wrap it with whatever layout partial your
  other dashboard pages use — open an existing file like
  views/dashboard/portfolio.eta (or similar) and copy its layout/include
  pattern around this content, e.g. something like:

    <% layout('layouts/dashboard', { title: 'Withdrawal settings' }) %>
    ...this file's content...

  or if this project uses explicit includes instead of a layout() call:

    <%~ include('partials/header', it) %>
    ...this file's content...
    <%~ include('partials/footer', it) %>

  Match whatever the rest of views/dashboard/ already does — don't guess,
  copy the real pattern from a sibling file.

  Expected `it` (data passed into the template):
    it.banks         -> array of { code, name }
    it.maturityDate  -> ISO date string or null
    it.isLocked      -> boolean
    it.submitted     -> boolean (true right after a successful POST)
    it.error         -> string|null, e.g. "missing_fields"
%>

<div class="withdrawal-page">
  <h1 class="withdrawal-page__title">Withdrawal settings</h1>
  <p class="withdrawal-page__subtitle">Where would you like to receive your funds?</p>

  <% if (it.submitted) { %>
    <div class="withdrawal-alert withdrawal-alert--success">
      Your withdrawal request has been submitted.
      <% if (it.isLocked) { %>
        It's marked <strong>pending</strong> until your funds unlock
        <% if (it.maturityDate) { %> on <strong><%= it.maturityDate %></strong><% } %>.
      <% } %>
    </div>
  <% } %>

  <% if (it.error === 'missing_fields') { %>
    <div class="withdrawal-alert withdrawal-alert--error">
      Please fill in all fields before submitting.
    </div>
  <% } %>

  <form method="POST" action="/dashboard/withdrawal" class="withdrawal-card">
    <div class="withdrawal-field">
      <label for="bank_code">🏦 Select your bank</label>
      <select id="bank_code" name="bank_code" required>
        <option value="" disabled selected>Choose bank...</option>
        <% it.banks.forEach(function(bank) { %>
          <option value="<%= bank.code %>"><%= bank.name %></option>
        <% }) %>
      </select>
    </div>

    <div class="withdrawal-field">
      <label for="account_number">Account number</label>
      <input
        type="text"
        id="account_number"
        name="account_number"
        placeholder="Enter account number"
        inputmode="numeric"
        autocomplete="off"
        required
      >
    </div>

    <div class="withdrawal-field">
      <label for="account_name">Account name</label>
      <input
        type="text"
        id="account_name"
        name="account_name"
        placeholder="Account holder name"
        autocomplete="off"
        required
      >
    </div>

    <div class="withdrawal-lock-notice">
      <span class="withdrawal-lock-notice__icon">🔒</span>
      <div>
        <strong>Funds lock period</strong>
        <p>
          <% if (it.maturityDate) { %>
            Your funds are locked until <strong><%= it.maturityDate %></strong> and cannot be withdrawn before the maturity date.
          <% } else { %>
            Your funds are locked for 7 months and cannot be withdrawn before the maturity date.
          <% } %>
        </p>
      </div>
    </div>

    <button type="submit" class="withdrawal-submit">
      <% if (it.isLocked) { %>Request withdrawal (pending until unlock)<% } else { %>Withdraw funds<% } %>
    </button>
  </form>
</div>
