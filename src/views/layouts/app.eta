<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= it.title %> — <%= it.brand.name %></title>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700;800&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/app.css">
<link rel="icon" href="/img/mark.svg" type="image/svg+xml">
<script src="https://unpkg.com/htmx.org@2.0.4" defer></script>
</head>
<body>
<div class="app">

  <aside class="side">
    <a class="logo" href="/">
      <svg class="logo-mark" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="#3B7BFF"/><path d="M8 22L13 13l4 5 3-4 4 8" stroke="#F5B82E" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <%= it.brand.name %>
    </a>

    <% it.nav.forEach(function(group){ %>
      <div class="side-grp">
        <p><%= group.label %></p>
        <% group.items.forEach(function(i){ %>
          <a href="<%= i.href %>"
             class="<%= (it.path === i.href || (i.href !== '/dashboard' && it.path.startsWith(i.href))) ? 'on' : '' %>"
             <%= (it.path === i.href || (i.href !== '/dashboard' && it.path.startsWith(i.href))) ? 'aria-current=page' : '' %>>
            <%~ i.icon %>
            <span class="label"><%= i.label %></span>
            <% if (i.tag) { %><span class="tag tag--<%= i.tag.toLowerCase() %>"><%= i.tag %></span><% } %>
          </a>
        <% }) %>
      </div>
    <% }) %>

    <div class="side-grp">
      <p>Account</p>
      <a href="/dashboard/account"
         class="<%= (it.path === '/dashboard/account' || it.path.startsWith('/dashboard/account/')) ? 'on' : '' %>"
         <%= (it.path === '/dashboard/account' || it.path.startsWith('/dashboard/account/')) ? 'aria-current=page' : '' %>>
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0116 0"/></svg>
        <span class="label">Account</span>
      </a>
      <a href="/dashboard/settings"
         class="<%= it.path === '/dashboard/settings' ? 'on' : '' %>"
         <%= it.path === '/dashboard/settings' ? 'aria-current=page' : '' %>>
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.6 1.6 0 00.3 1.8l.1.1a2 2 0 11-2.8 2.8l-.1-.1a1.6 1.6 0 00-2.7 1.1V21a2 2 0 11-4 0v-.1A1.6 1.6 0 006 19.4l-.1.1a2 2 0 11-2.8-2.8l.1-.1A1.6 1.6 0 003 15H3a2 2 0 110-4h.1A1.6 1.6 0 004.6 6l-.1-.1a2 2 0 112.8-2.8l.1.1A1.6 1.6 0 009 3.6V3a2 2 0 114 0v.1A1.6 1.6 0 0018 4.6l.1-.1a2 2 0 112.8 2.8l-.1.1A1.6 1.6 0 0021 9h0a2 2 0 110 4h-.1a1.6 1.6 0 00-1.5 1z"/></svg>
        <span class="label">Settings</span>
      </a>
      <form method="post" action="/logout" style="margin:6px 0 24px">
        <input type="hidden" name="_csrf" value="<%= it.csrf %>">
        <button type="submit" class="side-logout">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9"/></svg>
          <span class="label">Log out</span>
        </button>
      </form>
    </div>
  </aside>

  <div class="main">
    <div class="topbar">
      <button data-side-toggle aria-label="Menu" class="iconbtn">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </button>

      <div class="balance-chip" hx-get="/dashboard/partials/balance" hx-trigger="every 20s" hx-swap="innerHTML">
        <span>Available balance</span>
        <b class="num" data-watch><%= it.usd(it.bal.available) %></b>
      </div>

      <div class="topbar__balance"></div>

      <a href="/dashboard/notifications" class="iconbtn" aria-label="Notifications" style="position:relative">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9M13.7 21a2 2 0 01-3.4 0"/></svg>
        <% if (it.unread) { %>
          <span style="position:absolute;top:-6px;right:-6px;background:var(--down);color:#fff;font-size:.62rem;font-weight:700;min-width:17px;height:17px;border-radius:9px;display:grid;place-items:center;padding:0 4px;border:2px solid var(--bg-base)"><%= it.unread > 99 ? '99+' : it.unread %></span>
        <% } %>
      </a>

      <!-- Circular profile button with a dropdown user menu -->
      <div class="w-usermenu">
        <button type="button" class="w-usermenu__btn" data-user-menu aria-label="Open user menu" aria-expanded="false">
          <span class="avatar"><%= it.initials(it.user.firstName, it.user.lastName) %></span>
          <span class="w-usermenu__chev"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg></span>
        </button>
        <div class="w-usermenu__panel" hidden>
          <div class="w-usermenu__me">
            <span class="avatar"><%= it.initials(it.user.firstName, it.user.lastName) %></span>
            <div class="w-usermenu__name">
              <b><%= it.user.firstName %> <%= it.user.lastName %></b>
              <span><%= it.user.role === 'admin' ? 'Administrator' : 'Trading account' %></span>
            </div>
          </div>
          <a href="/dashboard/account" class="w-usermenu__item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0116 0"/></svg>
            Profile
          </a>
          <a href="/dashboard/account/profile" class="w-usermenu__item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M12 3l8 3v6c0 5-3.4 8-8 9-4.6-1-8-4-8-9V6z"/><path d="M9 12l2 2 4-4"/></svg>
            Account settings
          </a>
          <a href="/dashboard/account/password" class="w-usermenu__item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 018 0v4"/></svg>
            Security
          </a>
          <a href="/dashboard/notifications" class="w-usermenu__item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9M13.7 21a2 2 0 01-3.4 0"/></svg>
            Notifications
          </a>
          <form method="post" action="/logout" class="w-usermenu__logout">
            <input type="hidden" name="_csrf" value="<%= it.csrf %>">
            <button type="submit" class="w-usermenu__item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9"/></svg>
              Log out
            </button>
          </form>
        </div>
      </div>
    </div>

    <main class="content"><%~ it.body %></main>
  </div>
</div>

<!-- Mobile bottom navigation bar (Home / Explore / Portfolio / Activity / Learn) -->
<nav class="mobile-bottom-nav" aria-label="Mobile navigation">
  <a href="/dashboard" class="<%= it.path === '/dashboard' ? 'on' : '' %>" aria-label="Home">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M3 11l9-8 9 8"/><path d="M5 9.5V21h5v-6h4v6h5V9.5"/></svg>
    <span>Home</span>
  </a>
  <a href="/dashboard/markets" class="<%= it.path === '/dashboard/markets' ? 'on' : '' %>" aria-label="Explore">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><circle cx="12" cy="12" r="9"/><path d="M15.5 8.5l-2 5-5 2 2-5z"/></svg>
    <span>Explore</span>
  </a>
  <a href="/dashboard/portfolio" class="<%= it.path === '/dashboard/portfolio' ? 'on' : '' %>" aria-label="Portfolio">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M21.2 14A9 9 0 1110 2.8V12z"/><path d="M14 3a9 9 0 017 7h-7z"/></svg>
    <span>Portfolio</span>
  </a>
  <a href="/dashboard/activity" class="<%= it.path === '/dashboard/activity' ? 'on' : '' %>" aria-label="Activity">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M22 12h-4l-3 8-6-16-3 8H2"/></svg>
    <span>Activity</span>
  </a>
  <a href="/dashboard/learn" class="<%= it.path === '/dashboard/learn' ? 'on' : '' %>" aria-label="Learn">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M22 9L12 5 2 9l10 4 10-4z"/><path d="M6 11.5V17c0 1.7 2.7 3 6 3s6-1.3 6-3v-5.5"/><path d="M22 9v5"/></svg>
    <span>Learn</span>
  </a>
</nav>
<script src="/js/app.js" defer></script>
<% if (it.site && it.site.smartsuppKey) { %>
<!-- Smartsupp Live Chat script -->
<script type="text/javascript">
var _smartsupp = _smartsupp || {};
_smartsupp.key = '<%= it.site.smartsuppKey %>';
window.smartsupp||(function(d) {
  var s,c,o=smartsupp=function(){ o._.push(arguments)};o._=[];
  s=d.getElementsByTagName('script')[0];c=d.createElement('script');
  c.type='text/javascript';c.charset='utf-8';c.async=true;
  c.src='https://www.smartsuppchat.com/loader.js?';s.parentNode.insertBefore(c,s);
})(document);
</script>
<noscript>Powered by <a href="https://www.smartsupp.com" target="_blank">Smartsupp</a></noscript>
<% } %>
</body>
</html>
